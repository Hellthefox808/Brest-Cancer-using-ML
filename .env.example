# ==============================================================================
# Environment Configuration Template (OncoScreen ML)
# Copy this file to .env and customize values as needed.
# DO NOT commit real secrets or production keys to version control.
# ==============================================================================

# Flask Server Settings
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=False

# Application Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Pipeline & Model Paths (Optional - defaults to project directories)
# ARTIFACTS_DIR=artifacts
# DATA_DIR=data
# MODEL_FILE=artifacts/model.pkl
# METRICS_FILE=artifacts/metrics.json
